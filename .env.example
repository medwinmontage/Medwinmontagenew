# Copy this file to `.env` and fill it in. Never commit `.env`.

# --- Database (Supabase Postgres) ---------------------------------------------
# Supabase → Project Settings → Database → Connection string.
#   Local development and migrations: the "Session pooler" URI (port 5432).
#   Vercel: the "Transaction pooler" URI (port 6543) with ?pgbouncer=true&connection_limit=1 added.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Sessions -------------------------------------------------------------------
# Three different long random strings. Generate each with: openssl rand -base64 48
# Required in production (the app refuses to sign sessions without them).
ADMIN_JWT_SECRET="replace-with-a-long-random-secret"
CUSTOMER_JWT_SECRET="replace-with-a-different-long-random-secret"
# Crew members (Join as Crew) log in with their own account, signed with their own secret.
CREW_JWT_SECRET="replace-with-a-third-long-random-secret"

# --- Site address ---------------------------------------------------------------
# Used for canonical URLs, the sitemap and social previews. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase Storage + Realtime (optional locally, needed on Vercel) -----------
# Supabase → Project Settings → API.
# Leave these empty for local development: uploads then go to the local disk and
# dashboards refresh by polling.
SUPABASE_URL=""
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Safe for the browser: used only to listen for "something changed" pings.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Largest video an admin may upload, in MB (default 50 = Supabase's free-plan per-file limit).
# MAX_VIDEO_MB=50
# Bucket names (defaults shown; created by prisma/supabase-setup.sql)
# SUPABASE_PUBLIC_BUCKET="public-media"
# SUPABASE_PRIVATE_BUCKET="private-files"

# --- First admin account --------------------------------------------------------
# Used once by `npm run db:seed`. Change the password after the first login.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
